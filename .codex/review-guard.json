{
  "version": 1,
  "project": "FoodLog",
  "enabled": true,
  "scope": "changed-files",
  "privacy": "local-first",
  "commands": {
    "install": "",
    "lint": "",
    "test": "./gradlew testDebugUnitTest",
    "build": "./gradlew assembleDebug"
  },
  "paths": {
    "include": [
      "app/src/**",
      "app/schemas/**",
      "docs/**",
      "scripts/**",
      "*.gradle.kts",
      "gradle/**",
      "gradlew",
      "README.md",
      "AGENTS.md"
    ],
    "exclude": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      ".gradle/**",
      ".gradle-user-home/**",
      ".android-user-home/**",
      "build/**",
      "*/build/**",
      "local.properties",
      ".env",
      ".vercel/**",
      ".claude/**",
      "device-backups/**",
      "device-screenshots/**",
      "assets/labels/**"
    ]
  },
  "models": {
    "primary": "codex",
    "fallback": [
      "antigravity",
      "local-qwen"
    ]
  }
}
